{
  "formatVersion": 2,
  "contract": "nova-reader1",
  "api": "^1.0",
  "id": "kagane",
  "name": "Kagane",
  "version": "1.0.0",
  "language": "all",
  "nsfw": true,
  "entry": "main.js",
  "scripts": [],
  "assets": [
    "NOTICE.md",
    "LICENSE",
    "icon.png"
  ],
  "icon": "icon.png",
  "permissions": {
    "domains": [
      "kagane.moe",
      "kagane.cx",
      "kagane.net",
      "kstatic.to"
    ],
    "httpPost": true
  },
  "capabilities": [
    "capabilities",
    "browse",
    "search",
    "filters",
    "details",
    "chapters",
    "pages",
    "resolvePage"
  ],
  "configuration": [
    {
      "key": "mirror",
      "name": "Mirror",
      "kind": "select",
      "default": "kagane.moe",
      "options": [
        "kagane.moe",
        "kagane.cx",
        "kagane.net"
      ]
    },
    {
      "key": "contentRating",
      "name": "Maximum content rating",
      "kind": "select",
      "default": "safe",
      "options": [
        "safe",
        "fifteenplus",
        "eighteenplus"
      ]
    },
    {
      "key": "showPornographic",
      "name": "Show pornographic (18+ only)",
      "kind": "bool",
      "default": false
    },
    {
      "key": "showDisturbing",
      "name": "Show disturbing (18+ only)",
      "kind": "bool",
      "default": false
    },
    {
      "key": "sourceDisplay",
      "name": "Source selection",
      "kind": "select",
      "default": "all",
      "options": [
        "all",
        "official"
      ]
    },
    {
      "key": "cleanTitle",
      "name": "Clean title",
      "kind": "bool",
      "default": false
    },
    {
      "key": "showEdition",
      "name": "Show edition in title",
      "kind": "bool",
      "default": false
    },
    {
      "key": "showDetails",
      "name": "Show additional details",
      "kind": "bool",
      "default": true
    },
    {
      "key": "dataSaver",
      "name": "Data saver",
      "kind": "bool",
      "default": false
    },
    {
      "key": "chapterTitle",
      "name": "Chapter title format",
      "kind": "select",
      "default": "optional",
      "options": [
        "optional",
        "always",
        "vol_local",
        "vol_chapter"
      ]
    }
  ]
}
