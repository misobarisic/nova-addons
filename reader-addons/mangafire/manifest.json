{
  "formatVersion": 2,
  "contract": "nova-reader1",
  "api": "^1.0",
  "id": "mangafire",
  "name": "MangaFire",
  "version": "1.0.1",
  "language": "all",
  "nsfw": true,
  "entry": "main.js",
  "scripts": [
    "vrf.js",
    "filter-data.js"
  ],
  "assets": [
    "NOTICE.md",
    "LICENSE",
    "icon.png"
  ],
  "permissions": {
    "domains": [
      "mangafire.to",
      "mfcdn.nl",
      "mfcdn1.xyz"
    ],
    "httpPost": false
  },
  "capabilities": [
    "capabilities",
    "browse",
    "search",
    "filters",
    "details",
    "chapters",
    "pages"
  ],
  "configuration": [
    {
      "key": "contentRating",
      "name": "Content rating (source includes adult material)",
      "kind": "select",
      "default": "safe",
      "options": [
        "safe",
        "suggestive",
        "erotica",
        "pornographic",
        "all"
      ]
    },
    {
      "key": "preferVolumes",
      "name": "Prefer volume releases",
      "kind": "bool",
      "default": false
    },
    {
      "key": "mergeChapters",
      "name": "Merge editions with the same chapter number",
      "kind": "bool",
      "default": false
    },
    {
      "key": "preferOfficial",
      "name": "Prefer official editions when merging",
      "kind": "bool",
      "default": true
    }
  ],
  "icon": "icon.png"
}
